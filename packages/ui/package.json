{
  "name": "@karkata-ai/ui",
  "version": "0.1.0",
  "description": "Framework-neutral Agent UI store and optional Web Component panel for Karkata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenNorth/karkata.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/SevenNorth/karkata#readme",
  "bugs": {
    "url": "https://github.com/SevenNorth/karkata/issues"
  },
  "keywords": ["ai", "agent", "ui", "web-component", "typescript"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.js"
    }
  },
  "files": ["dist", "README.md", "README.en.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karkata-ai/core": "0.1.0"
  }
}
