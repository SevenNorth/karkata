{
  "name": "@karkata-ai/javascript",
  "version": "0.1.1",
  "description": "Explicitly registered unsafe JavaScript execution tool for trusted Karkata applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenNorth/karkata.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://github.com/SevenNorth/karkata#readme",
  "bugs": {
    "url": "https://github.com/SevenNorth/karkata/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "javascript",
    "tool",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karkata-ai/core": "0.1.1",
    "zod": "^4.3.6"
  }
}
