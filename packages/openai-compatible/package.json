{
  "name": "@karkata/openai-compatible",
  "version": "0.1.0",
  "description": "OpenAI-compatible chat completions adapter and concise Agent factory for Karkata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenNorth/karkata.git",
    "directory": "packages/openai-compatible"
  },
  "homepage": "https://github.com/SevenNorth/karkata#readme",
  "bugs": {
    "url": "https://github.com/SevenNorth/karkata/issues"
  },
  "keywords": ["ai", "agent", "openai", "llm", "typescript"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "README.en.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karkata/core": "0.1.0",
    "eventsource-parser": "^4.0.0",
    "zod": "^4.3.6"
  }
}
